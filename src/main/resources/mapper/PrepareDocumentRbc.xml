<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kh.bank.dgb.ibs.app.local.prepare_document.PrepareDocumentRbc">

	<resultMap id="mapper" type="kh.bank.dgb.ibs.app.local.prepare_document.PrepareDocument">
		<result property="code" column="code" />
		<result property="parentCode" column="parent_code" />
		<result property="item" column="item" />
	</resultMap>

	<select id="getPrepareDocumentList" resultMap="mapper">
		SELECT code, parent_code, item
		FROM prepare_document
		WHERE parent_code = #{parentCode}
	</select>

</mapper>
