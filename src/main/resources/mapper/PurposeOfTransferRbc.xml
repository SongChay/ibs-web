<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kh.bank.dgb.ibs.app.purpose_of_transfer.PurposeOfTransferRbc">

	<resultMap id="mapper" type="kh.bank.dgb.ibs.app.purpose_of_transfer.PurposeOfTransfer">
		<result property="code" column="code" />
		<result property="parentCode" column="parent_code" />
		<result property="item" column="item" />
		<result property="item1" column="item1" />
	</resultMap>

	<select id="getPurposeOfTransferList" resultMap="mapper">
		SELECT code, parent_code, item, item1
		FROM purpose_of_transfer
		ORDER BY code ASC
	</select>

</mapper>
